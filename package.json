{
  "name": "chrome-extension-collection",
  "version": "0.0.0",
  "private": true,
  "description": "A private workspace for focused Chrome extensions.",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:bugtrace": "pnpm --filter @juner/bugtrace-recorder dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  }
}
